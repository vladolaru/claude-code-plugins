{
  "credential_patterns": [
    "\\.env(?!\\.sample|\\.example|\\.template)",
    "client_secret\\.json",
    "\\.credentials\\.json",
    "token\\.pickle",
    "\\.pem$",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    "\\.key$",
    "\\.p12$",
    "\\.pfx$",
    "\\.jks$",
    "\\.keystore$"
  ],
  "credential_safe_patterns": [
    "\\.env\\.sample",
    "\\.env\\.example",
    "\\.env\\.template"
  ],
  "zero_access_paths": [
    "~/.ssh/",
    "~/.gnupg/",
    "~/.aws/",
    "~/.config/gcloud/"
  ],
  "disable_rules": []
}
