    {"weight": 2, "tool_name": "Write", "tool_input": {"file_path": "/project/tests/test_new.py", "content": "..."}, "label": "write_test"},

    {"weight": 1, "tool_name": "Bash", "tool_input": {"command": "git push origin main"}, "label": "bash_git_push"},
    {"weight": 1, "tool_name": "Bash", "tool_input": {"command": "git checkout -b feature/new"}, "label": "bash_git_checkout_b"},
    {"weight": 1, "tool_name": "Bash", "tool_input": {"command": "rm -rf /tmp/build"}, "label": "bash_rm_tmp"},
    {"weight": 1, "tool_name": "Bash", "tool_input": {"command": "chmod +x script.sh"}, "label": "bash_chmod_x"},
