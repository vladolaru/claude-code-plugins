    {"weight": 10, "tool_name": "Read", "tool_input": {"file_path": "/project/package.json"}, "label": "read_config"},
    {"weight": 5, "tool_name": "Read", "tool_input": {"file_path": "/project/tests/test_main.py"}, "label": "read_test"},
    {"weight": 5, "tool_name": "Read", "tool_input": {"file_path": "/project/.env.example"}, "label": "read_env_example"},
    {"weight": 5, "tool_name": "Read", "tool_input": {"file_path": "/project/src/utils/helpers.ts"}, "label": "read_nested"},

    {"weight": 5, "tool_name": "Bash", "tool_input": {"command": "git status"}, "label": "bash_git_status"},
    {"weight": 3, "tool_name": "Bash", "tool_input": {"command": "git diff"}, "label": "bash_git_diff"},
    {"weight": 3, "tool_name": "Bash", "tool_input": {"command": "git log --oneline -5"}, "label": "bash_git_log"},
    {"weight": 2, "tool_name": "Bash", "tool_input": {"command": "git add src/main.py"}, "label": "bash_git_add"},
    {"weight": 3, "tool_name": "Bash", "tool_input": {"command": "ls -la src/"}, "label": "bash_ls"},
    {"weight": 2, "tool_name": "Bash", "tool_input": {"command": "pwd"}, "label": "bash_pwd"},
    {"weight": 3, "tool_name": "Bash", "tool_input": {"command": "npm test"}, "label": "bash_npm_test"},
