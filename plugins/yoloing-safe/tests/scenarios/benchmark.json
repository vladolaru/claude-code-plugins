    {"weight": 2, "tool_name": "Bash", "tool_input": {"command": "node -e \"console.log(1+1)\""}, "label": "bash_node_inline"},
    {"weight": 2, "tool_name": "Bash", "tool_input": {"command": "pnpm build"}, "label": "bash_pnpm_build"},
    {"weight": 1, "tool_name": "Bash", "tool_input": {"command": "echo $PATH"}, "label": "bash_echo"},
