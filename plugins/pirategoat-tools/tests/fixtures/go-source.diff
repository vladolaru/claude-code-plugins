+package model
+
+// Order represents a customer order.
+type Order struct {
+	ItemID       string
+	Quantity     int
+	PricePerUnit float64
+}
+
+// NewOrder creates a new order.
+func NewOrder(itemID string, quantity int) *Order {
+	return &Order{
+		ItemID:   itemID,
+		Quantity: quantity,
+	}
+}
