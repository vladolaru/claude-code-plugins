+<?php
+
+use PHPUnit\Framework\TestCase;
+
+class CartTest extends TestCase {
+
+    public function test_add_item() {
+        $cart = new Cart();
+        $cart->add_item( 1, 2, 9.99 );
+        $this->assertCount( 1, $cart->get_items() );
+    }
+
+    public function test_get_total() {
+        $cart = new Cart();
+        $cart->add_item( 1, 2, 10.00 );
+        $this->assertEquals( 20.00, $cart->get_total() );
+    }
+}
