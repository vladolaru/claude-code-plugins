+describe( 'Cart', () => {
+    it( 'should add items', () => {
+        const cart = new Cart();
+        cart.addItem( 1, 2, 9.99 );
+        expect( cart.getItems() ).toHaveLength( 1 );
+    } );
+
+    it( 'should calculate total', () => {
+        const cart = new Cart();
+        cart.addItem( 1, 2, 10.0 );
