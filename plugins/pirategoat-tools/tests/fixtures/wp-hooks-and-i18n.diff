+<?php
+
+class Payment_Gateway {
+
+    public function __construct() {
+        add_action( 'init', [ $this, 'register_post_type' ] );
+        add_filter( 'woocommerce_payment_gateways', [ $this, 'add_gateway' ] );
+        add_action( 'wp_enqueue_scripts', [ $this, 'enqueue_assets' ] );
+    }
+
+    public function register_post_type() {
+        register_post_type( 'payment_log', [
+            'labels' => [
+                'name' => __( 'Payment Logs', 'my-plugin' ),
+                'singular_name' => __( 'Payment Log', 'my-plugin' ),
+            ],
+            'public' => false,
+        ] );
+    }
+
+    public function add_gateway( $gateways ) {
+        $gateways[] = 'My_Payment_Gateway';
+        return $gateways;
+    }
+
+    public function enqueue_assets() {
+        wp_enqueue_script(
+            'my-payment-js',
+            plugins_url( 'assets/js/payment.js', __FILE__ ),
+            [ 'jquery' ],
+            '1.0.0',
+            true
+        );
+    }
+
+    public function get_payment_log( $payment_id ) {
+        global $wpdb;
+
+        $result = $wpdb->get_row(
+            $wpdb->prepare( "SELECT * FROM {$wpdb->prefix}payment_logs WHERE id = %d", $payment_id )
+        );
+
+        return $result;
+    }
+
+    public function render_payment_status( $payment ) {
+        echo '<div class="status">' . $payment->status . '</div>';
+
+        echo '<div class="amount">' . esc_html( $payment->amount ) . '</div>';
+    }
+}
