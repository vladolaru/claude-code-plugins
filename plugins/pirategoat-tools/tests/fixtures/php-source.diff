@@ -0,0 +1,22 @@
+<?php
+
+class OrderProcessor {
+
+    private $payment_handler;
+    private $email_service;
+    private $logger;
+    private $inventory;
+
+    public function __construct( $payment, $email, $logger, $inventory ) {
+        $this->payment_handler = $payment;
+        $this->email_service = $email;
+        $this->logger = $logger;
+        $this->inventory = $inventory;
+    }
+
+    public function process( $order ) {
+        $this->payment_handler->process_payment( $order['user_id'], $order['amount'] );
+        $this->inventory->decrement( $order['product_id'] );
+        $this->email_service->send_confirmation( $order['user_id'] );
+        $this->logger->info( 'Order processed: ' . $order['id'] );
+    }
diff --git a/src/PaymentHandler.php b/src/PaymentHandler.php
new file mode 100644
index 0000000..fb50023
--- /dev/null
+++ b/src/PaymentHandler.php
@@ -0,0 +1,24 @@
+<?php
+
+class PaymentHandler {
+
+    private $db;
+
+    public function __construct( $db ) {
+        $this->db = $db;
+    }
+
+    public function process_payment( $user_id, $amount ) {
+        $result = $this->db->query(
+            "SELECT * FROM payments WHERE user_id = " . $_GET['user_id']
+        );
+
+        if ( $result ) {
+            $this->db->query(
+                "INSERT INTO payments (user_id, amount) VALUES ($user_id, $amount)"
+            );
+        }
+
+        return $result;
+    }
+}
