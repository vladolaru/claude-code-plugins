+	if order.ItemID != "item-1" {
+		t.Errorf("ItemID = %q, want %q", order.ItemID, "item-1")
+	}
+	if order.Quantity != 2 {
+		t.Errorf("Quantity = %d, want %d", order.Quantity, 2)
