+<?php
+
+use PHPUnit\Framework\TestCase;
+
+class OrderProcessorTest extends TestCase {
+
+    public function test_process_order() {
+        $payment = $this->createMock( PaymentHandler::class );
+        $email = $this->createMock( EmailService::class );
+        $logger = $this->createMock( Logger::class );
+        $inventory = $this->createMock( Inventory::class );
+
+        $processor = new OrderProcessor( $payment, $email, $logger, $inventory );
+
+        $order = [
+            'id' => 1,
+            'user_id' => 42,
+            'amount' => 99.99,
+            'product_id' => 7,
+        ];
+        $processor->process( $order );
+    }
+}
