+<?php
+
+use PHPUnit\Framework\TestCase;
+
+class PaymentHandlerTest extends TestCase {
+
+    public function test_process_payment() {
+        $mock_db = $this->createMock( Database::class );
+        $mock_db->method( 'query' )->willReturn( true );
+
+        $handler = new PaymentHandler( $mock_db );
+        $result = $handler->process_payment( 1, 100 );
+
+        // Missing assertion: test passes without checking anything meaningful
+        $this->assertNotNull( $result );
+    }
+
+    public function test_it_works() {
+        // Over-mocking: every dependency mocked, no real behavior tested
+        $mock_db = $this->createMock( Database::class );
+        $handler = new PaymentHandler( $mock_db );
+        $this->assertInstanceOf( PaymentHandler::class, $handler );
+    }
+}
