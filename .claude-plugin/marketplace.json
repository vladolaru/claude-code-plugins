{
  "name": "vladolaru-claude-code-plugins",
  "owner": {
    "name": "Vlad Olaru",
    "url": "https://github.com/vladolaru"
  },
  "metadata": {
    "description": "Vlad Olaru's Claude Code plugins marketplace",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "pirategoat-tools",
      "source": "./plugins/pirategoat-tools",
      "description": "Code review orchestration (11 specialized agents), WordPress/WooCommerce development patterns, testing guidance, and browser automation.",
      "version": "1.27.0",
      "author": {
        "name": "Vlad Olaru"
      },
      "repository": "https://github.com/vladolaru/claude-code-plugins",
      "license": "MIT",
      "keywords": ["wordpress", "project-management", "code-review", "browser-automation", "linear", "architecture", "design-patterns"],
      "category": "development-tools",
      "strict": true,
      "skills": [
        "./skills/wordpress-backend-dev",
        "./skills/browser-interaction",
        "./skills/dig-into-linear-issue",
        "./skills/woocommerce-browser-interaction",
        "./skills/pr-reviewing",
        "./skills/testing-patterns",
        "./skills/php-testing-patterns",
        "./skills/js-testing-patterns",
        "./skills/e2e-testing-patterns",
        "./skills/software-architecture"
      ],
      "commands": [
        "./commands/execute-plan.md",
        "./commands/fix-github-issue.md",
        "./commands/full-code-review.md",
        "./commands/code-review.md",
        "./commands/ingest-code-review.md",
        "./commands/pr-update.md"
      ],
      "agents": [
        "./agents/technical-writer.md",
        "./agents/pr-reviewer.md",
        "./agents/security-reviewer.md",
        "./agents/performance-reviewer.md",
        "./agents/architecture-reviewer.md",
        "./agents/wp-architecture-reviewer.md",
        "./agents/patterns-reviewer.md",
        "./agents/php-tests-reviewer.md",
        "./agents/js-tests-reviewer.md",
        "./agents/e2e-tests-reviewer.md",
        "./agents/gemini-reviewer.md",
        "./agents/codex-reviewer.md",
        "./agents/review-reconciliator.md",
        "./agents/tests-mutation-reviewer.md",
        "./agents/history-insights-reviewer.md",
        "./agents/dead-code-reviewer.md"
      ]
    },
    {
      "name": "image-optimizer",
      "source": "./plugins/image-optimizer",
      "description": "Lossless image optimization (PNG, JPEG, GIF, SVG) using imageoptim-cli and svgo with review/confirm workflow.",
      "version": "1.1.0",
      "author": {
        "name": "Vlad Olaru"
      },
      "repository": "https://github.com/vladolaru/claude-code-plugins",
      "license": "MIT",
      "keywords": ["image-optimization", "imageoptim", "svgo", "compression", "lossless"],
      "category": "productivity",
      "strict": true,
      "commands": [
        "./commands/optimize-images.md"
      ]
    },
    {
      "name": "prompt-engineer",
      "source": "./plugins/prompt-engineer",
      "description": "Human-in-the-loop prompt optimization with evidence-grounded pattern attribution using proven prompt engineering patterns.",
      "version": "2.1.0",
      "author": {
        "name": "Vlad Olaru"
      },
      "repository": "https://github.com/vladolaru/claude-code-plugins",
      "license": "MIT",
      "keywords": ["prompt-engineering", "optimization", "claude", "ai-prompts", "compression", "hitl", "subagents"],
      "category": "productivity",
      "strict": true,
      "skills": [
        "./skills/prompt-engineer"
      ],
      "commands": [
        "./commands/optimize-prompt.md"
      ]
    },
    {
      "name": "dex",
      "source": "./plugins/dex",
      "description": "Frictionless knowledge capture that compounds engineering work. Captures learnings, patterns, decisions, and research from conversations into agent-first documents, with optional promotion to CLAUDE.md.",
      "version": "1.4.1",
      "author": {
        "name": "Vlad Olaru"
      },
      "repository": "https://github.com/vladolaru/claude-code-plugins",
      "license": "MIT",
      "keywords": ["knowledge-capture", "compound-engineering", "learnings", "patterns", "decisions", "research", "claude-md"],
      "category": "productivity",
      "strict": true,
      "skills": [
        "./skills/knowledge-capture"
      ],
      "commands": [
        "./commands/grok.md",
        "./commands/init.md",
        "./commands/learn.md",
        "./commands/pattern.md",
        "./commands/research.md",
        "./commands/sharpen.md",
        "./commands/status.md"
      ]
    }
  ]
}
