    {
      "name": "yoloing-safe",
      "source": "./plugins/yoloing-safe",
      "description": "YOLO mode safety net \u2014 PreToolUse guardrails that block destructive commands (rm -rf, disk formatting, data exfiltration), ask for confirmation on the risky-but-maybe-intentional stuff (force push, permission changes), and nudge Claude toward safer alternatives. Configurable credential file protection. Because shipping fast shouldn't mean losing your home directory.",
      "version": "1.12.0",
      "author": {
        "name": "Vlad Olaru"
      },
      "repository": "https://github.com/vladolaru/claude-code-plugins",
      "license": "MIT",
      "keywords": [
        "safety",
        "yolo",
        "hooks",
        "security",
        "guardrails"
      ],
      "category": "security",
      "strict": true
    },
